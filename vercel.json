{
  "version": 2,
  "buildCommand": "npm run install-all && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/resume-parse.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
